<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <me.magnum.melonds.ui.settings.preferences.InGameLockedPreference
            android:key="input_key_mapping"
            android:title="@string/key_mapping"
            android:summary="@string/key_mapping_summary"
            app:iconSpaceReserved="false" />

    <me.magnum.melonds.ui.settings.preferences.InGameLockedPreference
        android:key="input_layouts"
        android:title="@string/layouts"
        android:summary="@string/layouts_summary"
        app:iconSpaceReserved="false" />

    <MultiSelectListPreference
        android:key="input_cycle_layout_ids"
        android:title="@string/cycle_layouts"
        android:summary="@string/cycle_layouts_summary"
        app:iconSpaceReserved="false" />

    <me.magnum.melonds.ui.settings.preferences.SoftwareInputBehaviourPreference
        android:key="soft_input_behaviour"
        android:title="@string/soft_input_behaviour"
        android:summary="%s"
        android:entries="@array/soft_input_behaviour_options"
        android:entryValues="@array/soft_input_behaviour"
        android:defaultValue="hide_system_buttons_when_controller_connected"
        app:fragment="me.magnum.melonds.ui.settings.fragments.SoftInputBehaviourPreferencesFragment"
        app:iconSpaceReserved="false" />

    <SwitchPreference
            android:key="input_touch_haptic_feedback_enabled"
            android:title="@string/vibrate_on_touch"
            app:iconSpaceReserved="false"
            android:defaultValue="true" />

    <!-- Vibration strength can go to 255 but the finer controls are in the lower values. As such, the max value is
         set to 100 -->
    <SeekBarPreference
            android:key="input_touch_haptic_feedback_strength"
            android:title="@string/vibration_strength"
            android:dependency="input_touch_haptic_feedback_enabled"
            app:iconSpaceReserved="false"
            app:updatesContinuously="true"
            android:defaultValue="30"
            app:min="1"
            android:max="100" />

    <SeekBarPreference
            android:key="input_opacity"
            android:title="@string/soft_input_opacity"
            app:iconSpaceReserved="false"
            android:defaultValue="50"
            android:max="100" />

    <PreferenceCategory
            android:key="screenshots_and_recording_category"
            android:title="@string/screenshots_and_recording"
            app:iconSpaceReserved="false">

        <ListPreference
                android:key="screenshot_scale"
                android:title="@string/screenshot_scale"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/screenshot_scale_options"
                android:entryValues="@array/screenshot_scale_values"
                android:defaultValue="1" />

        <ListPreference
                android:key="screenshot_screens"
                android:title="@string/screenshot_screens"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/capture_screens_options"
                android:entryValues="@array/capture_screens_values"
                android:defaultValue="both" />

        <me.magnum.melonds.ui.settings.preferences.StoragePickerPreference
                android:key="recording_directory"
                android:title="@string/recording_directory"
                app:iconSpaceReserved="false"
                app:type="directory"
                app:permissions="read_write"
                app:persistPermissions="true" />

        <ListPreference
                android:key="recording_scale"
                android:title="@string/recording_scale"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/recording_scale_options"
                android:entryValues="@array/recording_scale_values"
                android:defaultValue="2" />

        <ListPreference
                android:key="recording_screens"
                android:title="@string/recording_screens"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/capture_screens_options"
                android:entryValues="@array/capture_screens_values"
                android:defaultValue="both" />

        <ListPreference
                android:key="recording_frame_rate"
                android:title="@string/recording_frame_rate"
                android:summary="%s"
                app:iconSpaceReserved="false"
                android:entries="@array/recording_frame_rate_options"
                android:entryValues="@array/recording_frame_rate_values"
                android:defaultValue="60" />

        <ListPreference
                android:key="recording_clip_length"
                android:title="@string/recording_clip_length"
                android:summary="@string/recording_clip_length_summary"
                app:iconSpaceReserved="false"
                android:entries="@array/recording_clip_length_options"
                android:entryValues="@array/recording_clip_length_values"
                android:defaultValue="30" />

        <Preference
                android:key="delete_unsaved_recordings"
                android:title="@string/delete_unsaved_recordings"
                app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
